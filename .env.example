# Copy this file to .env and fill in the values. NEVER commit .env.

# LiveKit Cloud (https://cloud.livekit.io -> your project -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key

# Secret used to hash the last 4 SSN digits in the database. Use any long random string.
# If unset, an insecure development default is used. Changing it later requires:
#   python -m clinic.db --reset
SSN_HASH_KEY=change-me-to-a-long-random-string

# Optional: SQLite file location (default: data/clinic.db)
# DB_PATH=data/clinic.db

# Optional: simulate the clinic clock (Eastern wall-clock time, ISO format) to test open/closed hours.
# Leave unset for real time.
# CLINIC_NOW_OVERRIDE=2026-12-01T20:30

# Optional: per-call text transcripts for reviewing test calls (default: on). One .txt per call in TRANSCRIPT_DIR
# (git-ignored). Sensitive answers (name, date of birth, last four digits, phone, email, insurance, reason) are NOT
# stored; other text is redacted. The greeting tells the caller the call may be recorded and transcribed. "off" keeps
# nothing and the greeting says the call is not being recorded. Synthetic test callers only. See README, "Transcripts".
# TRANSCRIPTS=on
# TRANSCRIPT_DIR=transcripts

# ---- Text-to-speech chain (names only here; the keys go in .env) ---------------------------------------------------
# Providers in order of preference. The first one that works is used; if it fails (quota, 401/402/429, timeout, 5xx) the
# next one takes over for the rest of the call. A provider whose key or voice file is missing is skipped.
#   deepgram    Deepgram Aura-2 (needs DEEPGRAM_API_KEY; the credit is one-time, watch the usage log lines)
#   local       Piper on this PC: no key, no quota (needs models/piper/*.onnx, see README "Local TTS")
#   cloudflare  Workers AI Aura-2 (needs CLOUDFLARE_API_TOKEN or CLOUDFLARE_API_KEY, plus CLOUDFLARE_ACCOUNT_ID)
#   groq        Groq Orpheus (free tier: about 3,600 characters a day)
# TTS_PROVIDER_ORDER=deepgram,cloudflare,local
# Network voices (deepgram, cloudflare) are kept until each clip is complete, then played at once; a clip that misses its
# deadline is dropped before anything plays and the next provider speaks it. 0 = play audio as it arrives (can break up).
# TTS_HOLD=1
# A voice that just failed is skipped by the next calls for a few minutes (name, reason and time only; data/tts_health.json).
# TTS_HEALTH=on
# DEEPGRAM_API_KEY=your-deepgram-api-key
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# PIPER_MODEL=models/piper/en_US-hfc_female-medium.onnx   # female; closest of 4 voices tested to Deepgram's Thalia
# PIPER_LENGTH_SCALE=1.04    # local voice pace and loudness, tuned to sound like Deepgram so a switch is hard to notice
# PIPER_VOLUME=0.4
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_TTS_MODEL=@cf/deepgram/aura-2-en
# CLOUDFLARE_TTS_SPEAKER=thalia   # default: the speaker named in DEEPGRAM_TTS_MODEL, so both give the same voice
# Characters spoken are counted per call / per day / in total in data/tts_usage.json (counts only, no text) and logged.
# A warning is logged once a paid provider passes this many characters in total (default 100000).
# TTS_CHAR_WARN=100000
# TTS_USAGE_FILE=data/tts_usage.json

# Optional model overrides (defaults shown, verified against Groq's live model list)
# STT_MODEL=whisper-large-v3-turbo
# LLM_MODEL=openai/gpt-oss-120b
# TTS_MODEL=canopylabs/orpheus-v1-english
# TTS_VOICE=hannah

# Max Groq TTS requests per minute this agent will send (free tier allows 10; use ~9). Raise it
# only if your Groq plan allows more. 0 disables pacing.
# TTS_MAX_RPM=9

# LLM provider: router (default: ordered fallback across Groq models, see below), groq (one model) or gemini.
# A Gemini FREE key allowed only 20 requests/day and responded in 13 to 77 seconds when tested, so it is not
# usable for live calls (see README). Gemini's free tier may use your data to improve Google's products:
# synthetic test data only.
# LLM_PROVIDER=router
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_LLM_MODEL=gemini-3.5-flash

# ---- LLM router (default): ordered fallback across providers --------------------------------------------------
# LLM_PROVIDER=router        # router (default) | groq (single model) | gemini (not recommended on a free key)
# LLM_ORDER=groq-gpt-oss-120b,groq-gpt-oss-20b,groq-qwen,sambanova   # providers without a key are skipped
# LLM_FIRST_TOKEN_TIMEOUT=4  # seconds to wait for the first token before trying the next provider
# SAMBANOVA_API_KEY=your-sambanova-key          # NOTE: chat needs a payment method on SambaNova (HTTP 402 on a free key)
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id   # optional; both Cloudflare settings are needed to use it
# CLOUDFLARE_API_TOKEN=your-cloudflare-token
# CLOUDFLARE_LLM_MODEL=@cf/openai/gpt-oss-120b       # unverified: no key was available to test it
